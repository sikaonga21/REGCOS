# Regcos Christian Academy — environment variables
#
# The quickest way to fill this in is to let Vercel do it:
#
#   npx vercel link
#   npx vercel env pull .env.local
#
# Copy this file to .env.local to set anything by hand. Never commit .env.local.

# --- Vercel Postgres (required for the admin panel) -------------------------
# Created under Storage → Create → Postgres in your Vercel project. `vercel env
# pull` writes several aliases of the same URL; POSTGRES_URL is the pooled one
# and is what the app prefers.
POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=
# DATABASE_URL=

# --- Vercel Blob (required for image uploads) ------------------------------
# Created under Storage → Create → Blob. The long-lived token is what
# `handleUpload` needs in order to mint browser upload tokens.
BLOB_READ_WRITE_TOKEN=

# --- First admin account ---------------------------------------------------
# Used by `npm run db:setup` to create the first owner account. The login route
# will also create the first account from these values if `admin_users` is still
# empty, which is how you sign in to a fresh deployment without database access.
# Remove them once you have signed in and set a real password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email notifications (optional) ---------------------------------------
# Without a Resend key, enrollment applications are still stored in Postgres and
# visible under /admin/enrollments; only the notification email is skipped.
RESEND_API_KEY=

# --- Google Maps (optional, contact page) ---------------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
